---
/*
 * Gabarit unique de la vitrine. Il porte tout ce que le CDC §8 exige sur chaque
 * page : titre et description uniques, canonique absolu, Open Graph, langue.
 * Une page qui oublierait l'un des trois serait une page mal indexée, d'où le
 * choix de les rendre obligatoires par la signature des props plutôt que
 * facultatifs avec une valeur par défaut.
 */
import '../styles/global.css';

interface Props {
  titre: string;
  description: string;
  /** Données structurées JSON-LD propres à la page (CDC §8). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Libellé de la page dans le fil d'Ariane (CDC §8). Fourni, le gabarit émet
   * un `BreadcrumbList` : c'est ce qui remplace l'URL brute par « bailiz.fr ›
   * Bail meublé » dans un résultat de recherche. Omis sur l'accueil, qui est
   * la racine du fil, et sur la 404, qui n'est pas un contenu.
   */
  filAriane?: string;
  /** Pages sans valeur d'indexation (404). `follow` reste : les liens comptent. */
  noindex?: boolean;
}

const { titre, description, schema, filAriane, noindex = false } = Astro.props;

const canonique = new URL(Astro.url.pathname, Astro.site).href;
const imagePartage = new URL('/og.png', Astro.site).href;

/*
 * Un seul `<script type="application/ld+json">` par page : les moteurs
 * acceptent un tableau, et cela évite qu'une page oublie le fil d'Ariane en
 * fournissant son propre schéma.
 */
const filSchema = filAriane && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: filAriane, item: canonique },
  ],
};

const schemas = [schema, filSchema].flat().filter(Boolean);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    {/*
      `favicon.ico` reste déclaré : les navigateurs modernes prennent le SVG,
      mais les agrégateurs de liens et les lecteurs de flux vont encore chercher
      le `.ico`. C'est quelques centaines d'octets pour ne pas afficher une
      page blanche en vignette.
    */}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/*
      Manifeste de la vitrine, distinct de celui de l'application (CDC §8).
      Volontairement sans `start_url` ni `display` : il ne sert qu'à déclarer
      les icônes. Les ajouter rendrait la vitrine « installable », et le
      navigateur proposerait d'installer la page de présentation au lieu de
      l'outil - exactement la confusion que le §10 demande d'éviter.
    */}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#22524E" />

    {/*
      Préchargement de la fonte : elle porte le LCP (le titre du héros). Sans
      cela, le navigateur ne la découvre qu'après avoir analysé le CSS.
    */}
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Bailiz" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imagePartage} />
    {/*
      Dimensions déclarées : sans elles, plusieurs agrégateurs (dont LinkedIn)
      replient la grande carte sur une vignette carrée tant qu'ils n'ont pas
      téléchargé l'image.
    */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Bailiz - bail meublé et état des lieux gratuits et sans compte"
    />
    <meta name="twitter:card" content="summary_large_image" />

    {
      schemas.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)}
        />
      )
    }
  </head>

  <body>
    <header class="entete">
      <div class="enveloppe entete__contenu">
        {/*
          Même glyphe que la barre latérale de l'application
          (`src/components/ui/Marque.tsx`) et que le favicon : c'est le seul
          élément qui dise, au passage de la vitrine à l'outil, que c'est le
          même produit.
        */}
        <a class="marque" href="/">
          <svg viewBox="0 0 512 512" aria-hidden="true" focusable="false">
            <rect width="512" height="512" rx="112" fill="var(--m-700)" />
            <path d="M256 96 96 224v192h112v-96h96v96h112V224Z" fill="var(--c-50)" />
            <rect x="232" y="272" width="48" height="48" rx="8" fill="var(--m-700)" />
          </svg>
          Bailiz
        </a>
        <nav aria-label="Navigation principale">
          <a href="/bail-meuble/">Bail meublé</a>
          <a href="/etat-des-lieux/">État des lieux</a>
          <a href="/outils/">Outils</a>
          <a href="/pourquoi-bailiz/">Pourquoi</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pied">
      <div class="enveloppe">
        {/*
          Deux rangs plutôt qu'une file unique : sept outils et quatre liens de
          service mélangés donnaient une bouillie de treize libellés où plus
          rien ne se repérait.
        */}
        <nav aria-label="Outils">
          <a href="/bail-meuble/">Bail meublé</a>
          <a href="/etat-des-lieux/">État des lieux</a>
          <a href="/depot-de-garantie/">Dépôt de garantie</a>
          <a href="/grille-de-vetuste/">Grille de vétusté</a>
          <a href="/revision-de-loyer-irl/">Révision de loyer</a>
          <a href="/acte-de-cautionnement/">Acte de cautionnement</a>
          <a href="/fiche-de-visite/">Fiche de visite</a>
        </nav>
        <nav aria-label="Pied de page">
          <a href="/pourquoi-bailiz/">Pourquoi Bailiz</a>
          <a href="/mentions-legales/">Mentions légales</a>
          <a href="/confidentialite/">Confidentialité</a>
          <a href="https://github.com/Jami-INF/Bailiz_gestion_immo" rel="noopener">
            Code source
          </a>
        </nav>
        <p>
          Bailiz est une application gratuite, sans compte et sans publicité, éditée par Jami
          Infante. Les documents produits sont des modèles conformes aux textes en vigueur.
          Ils ne constituent pas un conseil juridique.
        </p>
      </div>
    </footer>
  </body>
</html>
