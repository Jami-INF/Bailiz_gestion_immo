---
/*
 * Une 404 doit proposer une sortie, pas constater l'échec (CDC §8).
 * Elle est en `noindex` : c'est une page d'erreur, pas un contenu.
 */
import Base from '../layouts/Base.astro';
---

<Base
  titre="Page introuvable | Bailiz"
  description="Cette page n'existe pas ou a été déplacée. Le bail meublé et l'état des lieux, eux, sont toujours là."
  noindex
>
  <section class="heros">
    <div class="enveloppe">
      <h1>Cette page n'existe pas</h1>
      <p class="accroche">
        Elle a peut-être été déplacée. Voici les deux endroits utiles :
      </p>
      <div class="actions">
        <a class="bouton bouton--principal" href="/app/#/baux/nouveau">Rédiger un bail</a>
        <a class="bouton bouton--secondaire" href="/app/#/edl/nouveau">Faire un état des lieux</a>
      </div>
      <p class="mention">
        Ou lire d'abord ce que font le <a href="/bail-meuble/">bail meublé</a> et
        l'<a href="/etat-des-lieux/">état des lieux</a>, puis revenir à
        <a href="/">l'accueil</a>.
      </p>
    </div>
  </section>
</Base>
